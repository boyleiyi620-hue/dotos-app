{
  "rules": {
    // HERKESE OKUMA VE YAZMA İZNİ VERİLDİ (Auth olmadan çalışması için)
    // Gerçek bir uygulamada bu güvenlik riski oluşturabilir, ancak auth istenmediği için bu şekilde ayarlandı.
    ".read": true,
    ".write": true,

    "users": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },

    "slugs": {
      "$slug": {
        ".read": true,
        ".write": true
      }
    },

    "friendCodes": {
      "$code": {
        ".read": true,
        ".write": true
      }
    },

    "friendRequests": {
      "$toUid": {
        ".read": true,
        "$fromUid": {
          ".read": true,
          ".write": true
        }
      }
    },

    "friendships": {
      "$ownerUid": {
        ".read": true,
        "$friendUid": {
          ".write": true
        }
      }
    },

    "data": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },

    "groupData": {
      "$groupId": {
        ".read": true,
        ".write": true
      }
    }
  }
}
